.version 8.8
.target sm_120
.address_size 64

.visible .entry vector_mix(
    .param .u64 vector_mix_out,
    .param .u64 vector_mix_a,
    .param .u64 vector_mix_b
)
{
    .reg .b32 %r<12>;
    .reg .b64 %rd<8>;

    ld.param.u64 %rd1, [vector_mix_out];
    ld.param.u64 %rd2, [vector_mix_a];
    ld.param.u64 %rd3, [vector_mix_b];
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ntid.x;
    mov.u32 %r3, %tid.x;
    mad.lo.u32 %r4, %r1, %r2, %r3;
    mul.wide.u32 %rd4, %r4, 4;
    add.s64 %rd5, %rd2, %rd4;
    add.s64 %rd6, %rd3, %rd4;
    add.s64 %rd7, %rd1, %rd4;
    ld.global.u32 %r5, [%rd5];
    ld.global.u32 %r6, [%rd6];
    mad.lo.u32 %r7, %r5, 1664525, %r6;
    shr.u32 %r8, %r7, 16;
    xor.b32 %r9, %r7, %r8;
    mul.lo.u32 %r10, %r9, 2246822519;
    shr.u32 %r11, %r10, 13;
    xor.b32 %r0, %r10, %r11;
    st.global.u32 [%rd7], %r0;
    ret;
}
